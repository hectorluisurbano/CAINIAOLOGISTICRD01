// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  AGENT
  ADMIN
}

enum ShipmentStatus {
  DRAFT
  PENDING
  RECEIVED_CHINA
  IN_TRANSIT
  CUSTOMS_HOLD
  CUSTOMS_CLEARED
  ARRIVED_RD
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum TransactionType {
  RECHARGE
  PAYMENT
  REFUND
  TRANSFER
  ADJUSTMENT
  HOLD
  RELEASE
  STORAGE_PENALTY
}

enum Currency {
  USD
  DOP
  CNY
}

enum HoldStatus {
  ACTIVE
  EXECUTED
  RELEASED
}

enum WarehouseStatus {
  PENDING_RECEIPT
  RECEIVED
  CONSOLIDATED
  SHIPPED
  DISCARDED
}

enum ContainerType {
  LCL
  FCL
}

enum OffshoreStatus {
  DRAFT
  AWAITING_QUOTATION
  PENDING_PAYMENT
  PURCHASE_IN_PROGRESS
  QC_PHASE
  READY_FOR_CONSOLIDATION
  COMPLETED
  CANCELLED
}

enum AuditSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
  SECURITY
}

model User {
  id              String         @id @default(cuid())
  name            String?
  email           String?        @unique
  password        String?
  role            Role           @default(USER)
  points          Int            @default(0)
  loyaltyHistory  LoyaltyHistory[]

  accounts        Account[]
  shipments       Shipment[]
  warehouseItems  WarehouseItem[]
  offshoreOrders  OffshoreOrder[]
  auditLogs       AuditLog[]

  version         Int            @default(1)
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([email, deletedAt])
}

model Account {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  currency      Currency       @default(USD)

  balance       Decimal        @default(0.00) @db.Decimal(12, 2)
  availableBalance Decimal     @default(0.00) @db.Decimal(12, 2)

  ledgerEntries LedgerEntry[]
  holds         Hold[]

  version       Int            @default(1)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([userId, currency])
}

model JournalEntry {
  id              String         @id @default(cuid())
  description     String
  idempotencyKey  String?        @unique
  referenceId     String?

  ledgerEntries   LedgerEntry[]

  createdAt       DateTime       @default(now())
}

model LedgerEntry {
  id            String          @id @default(cuid())
  accountId     String
  account       Account         @relation(fields: [accountId], references: [id])
  journalEntryId String
  journalEntry  JournalEntry    @relation(fields: [journalEntryId], references: [id])

  amount        Decimal         @db.Decimal(12, 2)
  balanceAfter  Decimal         @db.Decimal(12, 2)

  type          TransactionType
  createdAt     DateTime        @default(now())

  @@index([accountId, createdAt])
}

model Hold {
  id            String         @id @default(cuid())
  accountId     String
  account       Account        @relation(fields: [accountId], references: [id])
  amount        Decimal        @db.Decimal(12, 2)
  reason        String
  status        HoldStatus     @default(ACTIVE)

  referenceId   String?
  expiresAt     DateTime?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([accountId, status])
}

model Shipment {
  id              String         @id @default(cuid())
  trackingId      String         @unique
  status          ShipmentStatus @default(DRAFT)
  userId          String
  user            User           @relation(fields: [userId], references: [id])

  weightReal      Float?
  weightVol       Float?
  cost            Decimal?       @db.Decimal(10, 2)
  serviceType     String?

  customsStatus   String?
  customsNotes    String?

  items           WarehouseItem[]
  trackingHistory TrackingHistory[]

  containerId     String?
  container       Container?     @relation(fields: [containerId], references: [id])

  version         Int            @default(1)
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId, status])
  @@index([trackingId, deletedAt])
}

model TrackingHistory {
  id          String         @id @default(cuid())
  shipmentId  String
  shipment    Shipment       @relation(fields: [shipmentId], references: [id])
  fromStatus  ShipmentStatus?
  toStatus    ShipmentStatus
  location    String?
  description String?
  actorId     String?
  metadata    Json?
  createdAt   DateTime       @default(now())

  @@index([shipmentId])
}

model WarehouseItem {
  id          String          @id @default(cuid())
  sku         String?         @unique
  status      WarehouseStatus @default(PENDING_RECEIPT)

  userId      String
  user        User            @relation(fields: [userId], references: [id])

  shipmentId  String?
  shipment    Shipment?       @relation(fields: [shipmentId], references: [id])

  batchId     String?
  batch       Batch?          @relation(fields: [batchId], references: [id])

  offshoreOrderId String?
  offshoreOrder   OffshoreOrder? @relation(fields: [offshoreOrderId], references: [id])

  description String
  photos      String[]
  dimensions  Json?
  weight      Float?

  expiryDate  DateTime?
  receivedAt  DateTime?

  penalties   StoragePenalty[]

  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, status])
}

model Batch {
  id          String          @id @default(cuid())
  name        String
  items       WarehouseItem[]
  createdAt   DateTime        @default(now())
}

model Container {
  id          String          @id @default(cuid())
  number      String          @unique
  type        ContainerType   @default(LCL)
  shipments   Shipment[]
  createdAt   DateTime        @default(now())
}

model StoragePenalty {
  id              String         @id @default(cuid())
  warehouseItemId String
  warehouseItem   WarehouseItem  @relation(fields: [warehouseItemId], references: [id])
  amount          Decimal        @db.Decimal(10, 2)
  daysExceeded    Int
  createdAt       DateTime       @default(now())
}

model OffshoreOrder {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  status        OffshoreStatus @default(DRAFT)
  currentStep   Int            @default(1)

  productInfo   String
  estimatedQty  Int?

  supplierLinks SupplierLink[]
  warehouseItems WarehouseItem[]

  totalQuote    Decimal?       @db.Decimal(12, 2)
  holdId        String?

  version       Int            @default(1)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId, status])
}

model SupplierLink {
  id              String         @id @default(cuid())
  offshoreOrderId String
  offshoreOrder   OffshoreOrder  @relation(fields: [offshoreOrderId], references: [id])
  url             String
  price           Decimal?       @db.Decimal(12, 2)
  isValidated     Boolean        @default(false)
  notes           String?
  createdAt       DateTime       @default(now())
}

model AuditLog {
  id        String        @id @default(cuid())
  userId    String?
  user      User?         @relation(fields: [userId], references: [id])
  action    String
  severity  AuditSeverity @default(INFO)

  entity    String?
  entityId  String?
  oldValue  Json?
  newValue  Json?

  ipAddress String?
  userAgent String?
  traceId   String?

  metadata  Json?
  timestamp DateTime      @default(now())

  @@index([entity, entityId])
  @@index([userId, timestamp])
  @@index([severity])
  @@index([traceId])
}

model LoyaltyHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  points    Int
  reason    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
