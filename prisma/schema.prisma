// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  AGENT
  ADMIN
}

enum ShipmentStatus {
  DRAFT
  PENDING
  RECEIVED_CHINA
  IN_TRANSIT
  CUSTOMS_HOLD
  CUSTOMS_CLEARED
  ARRIVED_RD
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum TransactionType {
  RECHARGE
  PAYMENT
  REFUND
  TRANSFER
  ADJUSTMENT
  HOLD
  RELEASE
}

enum Currency {
  USD
  DOP
  CNY
}

enum HoldStatus {
  ACTIVE
  EXECUTED
  RELEASED
}

model User {
  id              String         @id @default(cuid())
  name            String?
  email           String?        @unique
  password        String?
  role            Role           @default(USER)
  points          Int            @default(0)
  loyaltyHistory  LoyaltyHistory[]

  accounts        Account[]
  shipments       Shipment[]
  warehouseItems  WarehouseItem[]
  auditLogs       AuditLog[]

  version         Int            @default(1)
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([email, deletedAt])
}

model Account {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  currency      Currency       @default(USD)

  // Ledger-based balance (Total funds)
  balance       Decimal        @default(0.00) @db.Decimal(12, 2)

  // Available funds (Balance - Active Holds)
  availableBalance Decimal     @default(0.00) @db.Decimal(12, 2)

  ledgerEntries LedgerEntry[]
  holds         Hold[]

  version       Int            @default(1)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([userId, currency])
}

model JournalEntry {
  id              String         @id @default(cuid())
  description     String
  idempotencyKey  String?        @unique
  referenceId     String?        // External reference (Stripe ID, etc.)

  ledgerEntries   LedgerEntry[]

  createdAt       DateTime       @default(now())
}

model LedgerEntry {
  id            String          @id @default(cuid())
  accountId     String
  account       Account         @relation(fields: [accountId], references: [id])
  journalEntryId String
  journalEntry  JournalEntry    @relation(fields: [journalEntryId], references: [id])

  amount        Decimal         @db.Decimal(12, 2)
  balanceAfter  Decimal         @db.Decimal(12, 2)

  type          TransactionType
  createdAt     DateTime        @default(now())

  @@index([accountId, createdAt])
}

model Hold {
  id            String         @id @default(cuid())
  accountId     String
  account       Account        @relation(fields: [accountId], references: [id])
  amount        Decimal        @db.Decimal(12, 2)
  reason        String
  status        HoldStatus     @default(ACTIVE)

  referenceId   String?        // ID of the related object (OffshoreOrder, etc.)
  expiresAt     DateTime?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([accountId, status])
}

model Shipment {
  id              String         @id @default(cuid())
  trackingId      String         @unique
  status          ShipmentStatus @default(DRAFT)
  userId          String
  user            User           @relation(fields: [userId], references: [id])

  weightReal      Float?
  weightVol       Float?
  cost            Decimal?       @db.Decimal(10, 2)
  serviceType     String?

  customsStatus   String?
  customsNotes    String?

  items           WarehouseItem[]
  trackingHistory TrackingHistory[]

  version         Int            @default(1)
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId, status])
  @@index([trackingId, deletedAt])
}

model TrackingHistory {
  id          String         @id @default(cuid())
  shipmentId  String
  shipment    Shipment       @relation(fields: [shipmentId], references: [id])
  fromStatus  ShipmentStatus?
  toStatus    ShipmentStatus
  location    String?
  description String?
  actorId     String?
  metadata    Json?
  createdAt   DateTime       @default(now())

  @@index([shipmentId])
}

model WarehouseItem {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  shipmentId  String?
  shipment    Shipment? @relation(fields: [shipmentId], references: [id])

  description String
  photos      String[]
  dimensions  Json?
  weight      Float?

  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String?
  entityId  String?
  oldValue  Json?
  newValue  Json?
  metadata  Json?
  timestamp DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId, timestamp])
}

model LoyaltyHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  points    Int      // Amount of points added/removed
  reason    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
